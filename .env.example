# Copy to .env and fill in. Grouped by the milestone that first needs each value.
# Never commit .env. Never hardcode any of these in source.

# ── M0 / M1: local infra ────────────────────────────────────────────────
DATABASE_URL="postgresql://launch_auditor:launch_auditor@localhost:5432/launch_auditor?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# ── M1: chain access (Robinhood Chain, id 4663) ─────────────────────────
CHAIN_ID=4663
# RPC comparison (2026-09-06, empirical). None of the free ones is ideal for a
# sustained backfill; a keyed / dedicated node is the production answer.
#   rpc-robinhood.blockmachine.io   archive OK; clean 10k getLogs cap; ~12-req burst then "rate limit exceeded" (retryable)  <- current pick
#   rpc.ordofi.network              600/min nominal but -32005 "network is busy" flaps; archive BROKEN ("missing trie node" at depth)
#   rpc.mainnet.chain.robinhood.com official; small queries OK; hard-throttles "Too Many Requests"; fine as a live-watcher secondary
#   robinhood.api.pocket.network    non-archive (full node) — recent queries only
#   robinhood-rpc.publicnode.com    every getLogs = "Archive requires a personal token"
RH_RPC_URL="https://rpc-robinhood.blockmachine.io"
RH_RPC_ARCHIVE_URL="https://rpc-robinhood.blockmachine.io"  # archive-capable (backfill §7 + outcome eth_call at old blocks); may equal RH_RPC_URL
RPC_BUDGET_RPM=90                        # keep under blockmachine's burst limit; raise for a keyed/dedicated node
# NOT reachable server-side (Cloudflare 403). Human-readable evidence URLs only;
# never fetched at runtime. See DECISIONS.md (post-M3 checkpoint).
BLOCKSCOUT_API_BASE="https://robinhoodchain.blockscout.com/api/v2"
WATCHER_POLL_INTERVAL_MS=2000
WATCHER_HEAD_LAG_BLOCKS=60      # read blocks this far behind head (reorg + load-balanced-RPC lag)
WATCHER_MAX_SPAN_BLOCKS=4000    # max blocks ingested per poll; chunks a big catch-up

# ── M2: external scanners + qualified lane ────────────────────────────
GOPLUS_API_KEY=""                        # optional; raises rate limits. token_security/4663 works without it
SCANHOOD_API_BASE="https://scanhood.xyz" # no key; ~5 req/s per IP
QUALIFY_UNIQUE_BUYERS=25                 # spec §3.1/§12: buyers in 10m to run feature 9

# ── M3: signing + commitment ──────────────────────────────────────────
AGENT_EIP712_PRIVATE_KEY=""   # signs reports (EIP-712)
GAS_WALLET_PRIVATE_KEY=""     # posts Merkle roots on chain 4663
COMMIT_REGISTRY_ADDRESS=""    # set after `forge script` deploy
COMMIT_INTERVAL_SEC=300
COMMIT_MAX_LEAVES=200

# ── M4: outcome resolution + scorer + backfill ───────────────────────
RPC_BUDGET_RPM=500           # global token-bucket cap shared by every RPC caller
OUTCOMES_BATCH=25             # outcomes picked per resolver sweep (shared fairly across labels)
OUTCOMES_CONCURRENCY=4        # outcomes resolved in parallel; the RPC budget above still caps total calls
OUTCOMES_QUALIFIED_ONLY=0     # 1 = INSIDER_EXIT/SELL_IMPAIRED/LIQ_IMPAIRED resolve for qualified-lane launches
                              # only (DRAWDOWN_80/TRADING_ALIVE stay universal). See DECISIONS.md 2026-09-15.
RPC_MAX_GETLOGS_RANGE=0      # 0 = probe the RPC's real limit on boot, then cache it
FEATURES_CONCURRENCY=8         # T+10m report-generation jobs run in parallel (was BullMQ's undocumented default of 1)
BACKFILL_DAYS=14             # spec §7 window (was 45; 14 clears the 200-resolved minimum)
BACKFILL_MAX_CALLS=0         # 0 = uncapped; set to enforce a hard RPC budget per run

# ── M5: Metabolism (Orbio MCP) ───────────────────────────────────────
ORBIO_MCP_URL="https://www.orbio.so/api/mcp"   # Streamable-HTTP MCP endpoint
METABOLISM_HYGIENE_ROTATE_DAYS=7               # key age ≥ this → hygiene ROTATING
METABOLISM_STATUS_POLL_SEC=60                  # lifecycle runner poll cadence (spec §8)
# RESERVE_USD replaces METABOLISM_RESERVE_R / _CLAIM_SIZE_USD (2026-09-09 decision:
# a key holds nothing, the account balance IS the quota, so there is nothing to
# "claim" and no claim size). Budget 3rd term becomes balance.usd - RESERVE_USD.
RESERVE_USD=3                                  # hard floor; balance − this ≤ 0 → STARVED
METABOLISM_LOW_WATER_USD=""                    # balance below this (but above reserve) → DRAINING. blank = 2 × RESERVE_USD
METABOLISM_IDS_TOLERANCE_USD=0.01             # IDS rounding tolerance — advisory since M5c (a ledger/provider gap is an estimator error, not a revoke)
# M5c — epoch reconciliation: provider spend delta is graded against local token-priced estimates every tick
METABOLISM_ANOMALY_PCT=50                     # |provider − estimate| / estimate above this % marks the epoch anomalous
METABOLISM_ANOMALY_EPOCHS=3                   # consecutive anomalous epochs before inference is PAUSED (never revoked)
METABOLISM_PHANTOM_TOLERANCE_USD=0.005        # provider delta below this with zero requests is rounding noise, not PHANTOM_SPEND
METABOLISM_IDS_GRACE_USD=""                   # IDS settlement grace; blank = DEEPDIVE_CAP_PER_RUN_USD + 0.05 (absorbs one in-flight deep-dive)
TOKEN_ENCRYPTION_KEY=""       # 32-byte base64 (openssl rand -base64 32); encrypts the persisted Orbio OAuth token at rest. `pnpm orbio:auth` prints one if unset.
ORBIO_OAUTH_CALLBACK_PORT=8976 # localhost port the one-time `pnpm orbio:auth` browser redirect lands on
ORBIO_TOKEN_STORE=""          # optional; path to the encrypted token store. Default: <repo-root>/.orbio/token-store.enc.json (gitignored)
# 2026-09-12, measured: Orbio's refresh grant is ONE-SHOT — first use 200 with no replacement
# refresh_token, any reuse 400 invalid_grant — and the MCP SDK wipes stored tokens on that
# failure. The provider therefore withholds refresh_token from the SDK by default: a 401 means
# "re-auth needed", the 1h access token stays on disk, and a worker tick racing a sign-in cannot
# destroy the fresh token. Unattended bound = one access lifetime (~1h). Set 1 to let the SDK
# take the single refresh (~2h) at the cost of a destructive wipe when the second one fails.
ORBIO_OAUTH_USE_REFRESH=0
# 2026-09-16: gateway (default) = the lifecycle runner reads balance/spend/key from GET {gateway}/key
# with the gateway key — unattended, no MCP session, always observe mode. mcp = the original OAuth path.
METABOLISM_SOURCE=gateway
# 2026-09-16, Orbio on-chain: wallet = the gateway key is the gas wallet's signature of
# "Orbio API key · chain 4663 · epoch N" (unknown to the gateway until that wallet first activates CREDIT).
ORBIO_KEY_SOURCE=env           # env | wallet
ORBIO_KEY_EPOCH=0              # rotation = a higher epoch
ORBIO_CREDIT_ADDRESS=""        # CREDIT token (chain 4663: 0xe33322da1380e61e5ae5dfb21e7f62924c73004c, verified 2026-09-16)
ORBIO_STAKING_ADDRESS=""       # Staking (chain 4663: 0xe0710011278bfb63e57c5f227e5980984b1eddca, verified 2026-09-16)
CREDIT_ACTIVATE=0              # 1 = the agent activates CREDIT it holds when its API balance is low
CREDIT_ACTIVATE_LOW_WATER_USD=2
CREDIT_ACTIVATE_CHUNK_USD=5
CREDIT_ACTIVATE_DAILY_CAP_USD="" # blank = DEEPDIVE_DAILY_CAP_USD
CREDIT_ACTIVATE_KEEP_WARM_HOURS=20 # activate even on a healthy balance once this long since the last self-activation
                                    # (margin before property 2's 24h accrual window goes cold and deadlocks — see DECISIONS.md)
ORBIO_AGENT_ACCOUNT=""          # api: public address of the agent's Orbio account (the gas wallet) for GET /v1/funding
ORBIO_FUNDING_FROM_BLOCK=""     # api: first block to scan for Activated events into that account
# 2026-09-15: a container has no token store. `pnpm railway:push-env --with-session` pushes a
# session-only seed (client registration + access token; NO gateway key, NO refresh token) that the
# worker writes to ORBIO_TOKEN_STORE at boot only when no store exists. Never set this by hand locally.
ORBIO_SESSION_SEED=""
# managed = the lifecycle runner mints/rotates/revokes (local default); observe = read balance + key
# status, log what it would do, never call create/revoke. Defaults to observe when ORBIO_SESSION_SEED is set.
METABOLISM_KEY_MANAGEMENT=""

# ── M6: LLM deep-dive (OpenRouter via the Orbio gateway) ─────────────
ORBIO_GATEWAY_V1_URL="https://api.orbio.so/api/v1"  # OpenAI-shape gateway base URL (from orbio_get_key_status)
ORBIO_API_KEY=""              # gateway key minted by orbio_create_key (secret shown once). The M5b runner persists it in the encrypted store; this is the fallback / local-dev override.
OPENROUTER_API_KEY=""         # legacy pre-gateway key; local dev only
OPENROUTER_HTTP_REFERER=""    # attribution: your dashboard URL (sent as HTTP-Referer on every call)
OPENROUTER_X_TITLE="Launch Auditor"
OPENROUTER_MODEL_DEEPDIVE=""  # REQUIRED before any scored run — pinned exact slug (no ~latest / openrouter/auto); it is committed per report
DEEPDIVE_CAP_PER_RUN_USD=0.20
DEEPDIVE_DAILY_CAP_USD=5
DEEPDIVE_MAX_STEPS=12          # max tool-execution turns per deep-dive run

# ── M7: API + payments ────────────────────────────────────────────────
PORT=3000
BENCHMARK_FILE="data/benchmark.json"  # worker writes a snapshot every 5 min; the API only reads it
REVENUE_ADDRESS=""            # plain address that receives USDG (no private key on server)
X402_FACILITATOR="canopy"     # canopy | solvador — not wired yet (spec §9: payments only if time remains)
PRICE_DEEPDIVE_USDG=0.10
DESIGN_PARTNER_API_KEYS=""    # comma-separated; required by POST /v1/deepdive and MCP request_deepdive (2026-09-16 — these spend the agent's Orbio balance)
# Revenue split: 2% of gross USDG -> ZachXBT as a periodic MANUAL transfer from
# REVENUE_ADDRESS, logged publicly. No splitter contract (spec §0.1 — minimise the
# money-handling surface; this supersedes the earlier M7 contract plan). DECISIONS.md.
SPLIT_ZACHXBT_BPS=200         # 2.00% — drives the manual-transfer accounting
SPLIT_ZACHXBT_ADDRESS="0x6eA158145907a1fAc74016087611913A96d96624"  # his public donation address

# ── M8: dashboard + free feed ─────────────────────────────────────────
WEB_PORT=3002                  # apps/web's static file server; reads $PORT first (Railway), this is the local-dev fallback
TELEGRAM_BOT_TOKEN=""          # from @BotFather; unset disables the poster entirely (no channel to spam)
TELEGRAM_CHANNEL_ID=""         # e.g. "@your_channel" or a numeric chat id; the bot must be an admin of it
TELEGRAM_POSTER_INTERVAL_MS=30000  # how often the worker sweeps for unposted qualified-launch reports
PUBLIC_API_BASE_URL=""            # e.g. https://api-…up.railway.app — each feed post links /v1/proof/<hash> so a reader can verify that
                                   # specific forecast. Commits are Merkle-batched, so the tx alone is shared across many launches.

# ── M9: deploy, health, metrics, ops alerts ───────────────────────────
WORKER_PORT=3010                    # the worker's own /health listener. Not PORT: this file already sets
                                     # PORT=3000 for the api, and both processes read this same .env locally.
TELEGRAM_ALERTS_CHANNEL_ID=""       # optional separate ops channel; blank falls back to TELEGRAM_CHANNEL_ID
ALERTS_INTERVAL_MS=60000            # how often the worker evaluates STARVED / IDS trip / commit lag / watcher stalled
ALERTS_COMMIT_LAG_SEC=600           # 10 min (build-guide M9)
ALERTS_WATCHER_STALLED_SEC=300      # 5 min (build-guide M9)
